<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap rescap">
  <!-- RPCS3 for Game Vault: a fork of RPCS3 for Xbox by emelin2004 (GPL-2), its own app so it installs beside the
       original. Publisher must match the Game Vault signing certificate. -->
  <Identity Name="GamerDad.RPCS3ForGameVault" Publisher="CN=GamerDad" Version="0.1.35.1600" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>RPCS3 for Game Vault</DisplayName>
    <PublisherDisplayName>Skitzelles (Game Vault), from RPCS3 for Xbox by emelin2004</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
    <!-- RPCS3 for Game Vault: no WinUI 2 dependency, so nothing else has to be installed first; the menu then keeps the
         standard control styles (uwp_xaml.cpp falls back by itself). -->
    <!-- Microsoft's C++ runtime for smb2.dll (network games, Game Vault's build); every console with Game Vault has
         it already (Game Vault depends on it too) -->
    <PackageDependency Name="Microsoft.VCLibs.140.00" MinVersion="14.0.30704.0"
                       Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="rpcs3_uwp.exe" EntryPoint="RPCS3Xbox.App">
      <uap:VisualElements DisplayName="RPCS3 for Game Vault" Description="PlayStation 3 for Game Vault: RPCS3 for Xbox (emelin2004) with Game Vault's launch link"
                          BackgroundColor="#1A1A1F" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Game Vault starts a game with gamevault-rpcs3:?cmd=rpcs3 "<game path>"&launchOnExit=<link back> -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="gamevault-rpcs3">
            <uap:DisplayName>RPCS3 for Game Vault</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
    <Application Id="ImportCheck" Executable="rpcs3_uwp_importcheck.exe" EntryPoint="RPCS3Xbox.ImportCheck">
      <uap:VisualElements DisplayName="RPCS3 for Game Vault import check" Description="Lists the system functions the emulator needs that this device is missing"
                          BackgroundColor="#1A1A1F" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>
  <!-- Game Vault's shared folder (same publisher): the one-time sign-in file of a network game is left there -->
  <Extensions>
    <Extension Category="windows.publisherCacheFolders">
      <PublisherCacheFolders>
        <Folder Name="games" />
      </PublisherCacheFolders>
    </Extension>
  </Extensions>
  <Capabilities>
    <Capability Name="codeGeneration" />
    <Capability Name="internetClient" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <rescap:Capability Name="broadFileSystemAccess" />
    <uap:Capability Name="removableStorage" />
  </Capabilities>
</Package>
